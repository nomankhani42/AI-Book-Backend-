# ============================================================================
# ENVIRONMENT CONFIGURATION FILE
# ============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit the .env file to version control!

# ============================================================================
# GEMINI API CONFIGURATION
# ============================================================================
# Get your API key from: https://aistudio.google.com/apikey
# Documentation: https://ai.google.dev/gemini-api/docs/api-key
GEMINI_API_KEY=AIzaSyBhf3IGn0Y3OBMRVZYX5bqaKdJTYLyuCVQ

# Gemini model to use (options: gemini-2.0-flash, gemini-1.5-pro, etc.)
GEMINI_MODEL=gemini/gemini-2.0-flash

# ============================================================================
# QDRANT CONFIGURATION
# ============================================================================
# Qdrant can run in three modes:
# 1. Local in-memory mode - data is not persisted (for quick testing)
# 2. Local persistent mode - data is saved to disk
# 3. Remote server mode - connect to Qdrant Cloud or self-hosted instance (RECOMMENDED)

# Mode: local (in-memory), local-persistent, or remote
QDRANT_MODE=remote

# For remote mode: Qdrant server URL
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Option 1: Self-hosted Qdrant (using Docker)
#   Run: docker-compose up -d
#   Then use: http://localhost:6333
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
QDRANT_URL=https://4f6b616b-524a-489c-8eaa-4dca929c9020.europe-west3-0.gcp.cloud.qdrant.io

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Option 2: Qdrant Cloud (Production)
#   1. Sign up at: https://cloud.qdrant.io/
#   2. Create a cluster
#   3. Copy your cluster URL and API key
#   Example URL: https://xyz-example.eu-central.aws.cloud.qdrant.io:6333
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# QDRANT_URL=https://your-cluster-id.your-region.aws.cloud.qdrant.io:6333

# For remote mode: API key (required for Qdrant Cloud, optional for self-hosted)
# Get from: https://cloud.qdrant.io/ (under your cluster settings)
QDRANT_API_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJhY2Nlc3MiOiJtIn0.z6LlpWDNIBdomOdRtn7cKa9Sm0Vo4peNwgWfxr8Yeao

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# For local modes only (not needed for remote):
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# QDRANT_MODE=local-persistent
# QDRANT_PATH=./qdrant_data

# Qdrant collection name for storing document embeddings
QDRANT_COLLECTION_NAME=chatbot_documents

# Vector dimension size (must match your embedding model)
# For sentence-transformers/all-MiniLM-L6-v2: 384
# For text-embedding-3-small: 1536
VECTOR_SIZE=384

# ============================================================================
# EMBEDDING MODEL CONFIGURATION
# ============================================================================
# Model for generating text embeddings
# Options:
# - sentence-transformers/all-MiniLM-L6-v2 (384 dims, fast, local)
# - sentence-transformers/all-mpnet-base-v2 (768 dims, accurate, local)
# - BAAI/bge-small-en-v1.5 (384 dims, good quality)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ============================================================================
# FASTAPI APPLICATION CONFIGURATION
# ============================================================================
# Application title shown in API docs
APP_TITLE=RAG Chatbot API

# Application version
APP_VERSION=1.0.0

# API description
APP_DESCRIPTION=A RAG-powered chatbot API using FastAPI, OpenAI Agents SDK, Gemini, and Qdrant

# Server host
HOST=0.0.0.0

# Server port
PORT=8000

# Environment: development, staging, production
ENVIRONMENT=development

# Enable debug mode (set to false in production)
DEBUG=true

# Enable CORS (Cross-Origin Resource Sharing)
CORS_ENABLED=true

# Allowed CORS origins (comma-separated)
# For development, use: http://localhost:3000,http://localhost:5173
# For production, specify your frontend domain(s)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ============================================================================
# AGENT CONFIGURATION
# ============================================================================
# Default agent name
AGENT_NAME=RAG Assistant

# Agent instructions/system prompt
AGENT_INSTRUCTIONS=You are a helpful AI assistant with access to a knowledge base. Use the provided context to answer questions accurately. If you don't know the answer, say so.

# Maximum number of search results to retrieve from Qdrant
MAX_SEARCH_RESULTS=5

# Minimum similarity score for search results (0.0 to 1.0)
MIN_SIMILARITY_SCORE=0.5

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ============================================================================
# OPTIONAL: MODEL CONFIGURATION
# ============================================================================
# Temperature for model responses (0.0 to 1.0)
# Lower = more deterministic, Higher = more creative
MODEL_TEMPERATURE=0.7

# Maximum tokens in response
MODEL_MAX_TOKENS=1000

# ============================================================================
# TRACING CONFIGURATION
# ============================================================================
# Disable OpenAI Agents SDK tracing (RECOMMENDED for Gemini)
# Set to false only if you want to use OpenAI's tracing dashboard
# When using non-OpenAI models like Gemini, keep this as true
DISABLE_TRACING=true

# Optional: OpenAI API key for exporting traces (only needed if DISABLE_TRACING=false)
# This is separate from GEMINI_API_KEY and is used for sending traces to OpenAI
# Get from: https://platform.openai.com/api-keys
TRACING_EXPORT_API_KEY=
